@model SelectList

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>index</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/Vasko.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <div class="container">
            <nav class="navbar navbar-expand-md navbar-dark bg-dark">
                <partial name="_MenuPartial" />
                <partial name="_UserInfoPartial" />
            </nav>
        </div>
    </header>

    <main class="container">
        <h2 class="mt-3 mb-3">@ViewData["text"]</h2>

        <h4>Список</h4>
        <ol type="A" class="mb-4">
            @for (int i = 0; i < 5; i++)
            {
                <li>элемент @i списка</li>
            }
        </ol>

        <h4>Форма</h4>
        <form method="post" action="#">
            <!-- ДОБАВЛЕН SELECT -->
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">Выберите элемент</label>
                <div class="col-sm-10">
                    <select class="form-select" asp-items="Model" name="selDemo"></select>
                </div>
            </div>

            <input type="text" name="input1" /> <br />
            <input type="checkbox" name="cb" /><label>Ok</label>
            <br />
            <input type="submit" value="Send" />
        </form>
    </main>

    <footer>
        <div class="container">
            <div class="navbar navbar-dark navbar-expand-md bg-dark">
                <div class="navbar-nav ms-auto">
                    <a class="nav-item nav-link" href="http://www.facebook.com">
                        <i class="fa-brands fa-facebook-f fa-2x"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.vk.com">
                        <i class="fa-brands fa-vk fa-2x"></i>
                    </a>
                    <a class="nav-item nav-link" href="http://www.twitter.com">
                        <i class="fa-brands fa-twitter fa-2x"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
@using Vasko.U1.Domain.Models
@model Dictionary<int, CartItem>

@{
    ViewData["Title"] = "Корзина";
}

<h2 class="m-2">Ваша корзина:</h2>

@if (Model.Count == 0)
{
    <h3 class="text-muted">Корзина пуста</h3>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Изображение</th>
                <th>Название</th>
                <th>Описание</th>
                <th>Количество</th>
                <th>Калории</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.Value.Item.Image" width="100" />
                    </td>
                    <td>@item.Value.Item.Name</td>
                    <td>@item.Value.Item.Description</td>
                    <td>@item.Value.Qty</td>
                    <td>@(item.Value.Item.Calories* item.Value.Qty)</td>
                    <td>
                        <a asp-action="Remove" asp-controller="Cart"
                           asp-route-id="@item.Value.Item.Id"
                           class="btn btn-danger">
                            <i class="fas fa-trash"></i> Удалить
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <strong>Общее количество калорий: @Model.Sum(item => item.Value.Item.Calories * item.Value.Qty)</strong>
    </div>
}